# === Base ===
/.env
/.env.*
/vendor/
/node_modules/
/.DS_Store
/.idea/
/.vscode/

# === Logs & runtime ===
/storage/*
!/storage/.gitkeep

# Backups (générés manuellement)
/backups/*
!/backups/.gitkeep

# Composer artefacts éventuels
/composer.phar

# Dumps / exports
*.sql
*.dump
*.archive

# Tests (si génération de caches)
/phpunit.xml.cache
/coverage/

# Docker context bruit éventuel
/docker/php/tmp/

# === Dossiers intentionnellement vides conservés ===
/app/Helpers/*
!/app/Helpers/.gitkeep
!/app/Services/*.php
!/app/Services/.gitkeep
/app/Validators/*
!/app/Validators/.gitkeep

# Eviter inclusion fichiers sensibles accidentels
*.pem
*.key
*.crt

# System
Thumbs.db
# Ignore Windows Zone.Identifier ADS exports
*:[Zz]one.Identifier

