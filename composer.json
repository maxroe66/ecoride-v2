{
  "name": "ecoride/app",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-mongodb": "*"
  },
  "autoload": {
    "psr-4": {
        "App\\": "app/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r 'echo \"Composer install complete\\n\";'"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": false,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  }
}
